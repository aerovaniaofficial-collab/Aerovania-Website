Options -Indexes

RewriteEngine On

# Block hidden files and folders (.git, .vscode, .env), except .well-known
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Redirect index.html to root
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Remove .html extension — redirect requests with .html to clean URL
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve .html files for clean URLs (no redirect loop)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Force www
RewriteCond %{HTTP_HOST} ^aerovania\.com$ [NC]
RewriteRule ^(.*)$ https://www.aerovania.com/$1 [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Custom error pages
ErrorDocument 404 /index.html
